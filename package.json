{
  "name": "@stackline/loading-core",
  "version": "1.0.1",
  "description": "Framework-agnostic TypeScript loading toolkit with spinners, overlays, skeletons, shimmer loaders, and smart anti-flicker behavior.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run build:lib && npm run build:docs",
    "build:download": "node scripts/build-download.mjs",
    "build:all": "npm run build && npm run build:download",
    "build:lib": "tsup --config tsup.config.ts",
    "postbuild:lib": "node scripts/normalize-declarations.mjs",
    "build:docs": "vite build --config vite.config.ts",
    "preview:docs": "vite preview --config vite.config.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:legacy": "node node_modules/typescript-3-9/bin/tsc -p scripts/tsconfig.typescript-3.9.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build:all && npm run typecheck:legacy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/loading.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "loading",
    "loader",
    "loading-state",
    "loading-indicator",
    "loading-overlay",
    "loading-spinner",
    "fullscreen-loader",
    "inline-loader",
    "button-loader",
    "section-loader",
    "skeleton-loader",
    "shimmer-loader",
    "progress-indicator",
    "spinner",
    "dots-loader",
    "bars-loader",
    "pulse-loader",
    "overlay",
    "fullscreen",
    "skeleton",
    "shimmer",
    "typescript",
    "javascript",
    "vanilla-js",
    "dom",
    "esm",
    "cjs",
    "tree-shakeable",
    "framework-agnostic",
    "ui",
    "design-system",
    "web-app",
    "dashboard",
    "accessibility",
    "aria-live",
    "reduced-motion",
    "css-variables",
    "themeable",
    "docs",
    "toolkit"
  ],
  "author": "Alexandro Marques",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexandroit/loading/issues"
  },
  "homepage": "https://alexandro.net/docs/vanilla/loading/",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-3-9": "npm:typescript@3.9.10",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
